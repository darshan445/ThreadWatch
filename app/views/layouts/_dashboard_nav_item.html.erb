<% active_class = active ? "bg-orange-50 text-orange-600 font-semibold" : "text-gray-600 hover:bg-gray-50 hover:text-gray-900" %>
<%= link_to path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-sm #{active_class}" do %>
  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon %>"/>
  </svg>
  <span class="flex-1"><%= label %></span>
  <% if defined?(badge) && badge.to_i > 0 %>
    <span class="ml-auto text-xs font-bold text-white rounded-full px-1.5 py-0.5 min-w-[20px] text-center"
          style="background:#FF4500"><%= badge %></span>
  <% end %>
<% end %>
