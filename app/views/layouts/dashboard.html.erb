<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? "#{yield(:title)} · ThreadWatch" : "ThreadWatch" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { colors: { reddit: { DEFAULT: '#FF4500', dark: '#E03D00' } } } }
    }
  </script>
  <%= yield :head %>
  <script>
    function rlUseTemplate(btn) {
      const body = btn.dataset.templateBody;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(body);
      } else {
        const el = document.createElement("textarea");
        el.value = body;
        el.style.position = "fixed"; el.style.opacity = "0";
        document.body.appendChild(el); el.select();
        document.execCommand("copy");
        document.body.removeChild(el);
      }
      btn.closest("details").removeAttribute("open");
      const csrf = document.querySelector("meta[name=csrf-token]")?.content;
      fetch(btn.dataset.useUrl, {
        method: "PATCH",
        headers: { "X-CSRF-Token": csrf, "Accept": "application/json" },
        credentials: "same-origin"
      });
    }
  </script>
</head>
<body class="bg-gray-50 antialiased">

<%# Mobile top bar %>
<div class="lg:hidden flex items-center justify-between px-4 h-14 bg-white border-b border-gray-200 sticky top-0 z-40">
  <a href="<%= dashboard_path %>" class="text-xl font-extrabold" style="color:#FF4500">ThreadWatch</a>
  <button type="button" onclick="document.getElementById('sidebar').classList.toggle('hidden')"
          class="p-2 rounded-lg text-gray-500 hover:bg-gray-100">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>
</div>

<div class="flex min-h-screen">

  <aside id="sidebar"
         class="hidden lg:flex flex-col w-60 bg-white border-r border-gray-200 fixed inset-y-0 z-30 lg:static lg:inset-auto">

    <div class="flex items-center gap-2 px-5 h-16 border-b border-gray-100">
      <a href="<%= dashboard_path %>" class="text-xl font-extrabold" style="color:#FF4500">ThreadWatch</a>
    </div>

    <nav class="flex-1 px-3 py-4 space-y-0.5 overflow-y-auto">
      <%= render "layouts/dashboard_nav_item",
            path: dashboard_path,
            label: "Dashboard",
            icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
            active: controller_name == "dashboard" %>

      <%= render "layouts/dashboard_nav_item",
            path: watchers_path,
            label: "My Watchers",
            icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
            active: controller_name == "watchers" %>

      <%= render "layouts/dashboard_nav_item",
            path: reply_templates_path,
            label: "Reply Templates",
            icon: "M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z",
            active: controller_name == "reply_templates" %>

      <%= render "layouts/dashboard_nav_item",
            path: edit_user_registration_path,
            label: "Settings",
            icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
            active: false %>
    </nav>

    <div class="border-t border-gray-100 p-3">
      <%= button_to destroy_user_session_path, method: :delete,
            class: "w-full flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700" do %>
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Logout
      <% end %>
    </div>
  </aside>

  <div class="flex-1 min-w-0 flex flex-col lg:ml-0">

    <% if flash.any? %>
      <div class="px-6 pt-4">
        <% flash.each do |type, msg| %>
          <% style = type.to_s == "alert" ? "bg-red-50 border-red-200 text-red-700" : "bg-green-50 border-green-200 text-green-700" %>
          <div class="rounded-xl border px-4 py-3 text-sm font-medium mb-2 <%= style %>"><%= msg %></div>
        <% end %>
      </div>
    <% end %>

    <main class="flex-1 px-6 py-6 max-w-6xl w-full mx-auto">
      <%= yield %>
    </main>

  </div>
</div>

</body>
</html>
