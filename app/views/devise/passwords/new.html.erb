<% content_for :title, "Forgot Password" %>

<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4 text-2xl"
       style="background:#FFF0EB">
    🔒
  </div>
  <h1 class="text-2xl font-extrabold text-gray-900">Forgot your password?</h1>
  <p class="text-sm text-gray-500 mt-1 leading-relaxed">
    No worries. Enter your email and we'll send<br>you a reset link right away.
  </p>
</div>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="mb-6">
    <%= f.label :email, "Email address", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: "you@example.com",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%= f.submit "Send Reset Instructions",
        class: "w-full py-3 rounded-xl font-bold text-white text-base cursor-pointer transition-transform hover:scale-[1.02]",
        style: "background:#FF4500" %>

<% end %>

<div class="flex items-center gap-3 my-6">
  <div class="flex-1 h-px bg-gray-200"></div>
  <span class="text-xs text-gray-400">or</span>
  <div class="flex-1 h-px bg-gray-200"></div>
</div>

<div class="flex flex-col gap-2">
  <%= link_to new_user_session_path,
        class: "block w-full py-3 rounded-xl font-semibold text-sm text-center border-2 border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors" do %>
    ← Back to Sign In
  <% end %>
  <%= link_to new_user_registration_path,
        class: "block w-full py-2 text-center text-sm font-medium hover:underline", style: "color:#FF4500" do %>
    Create a new account
  <% end %>
</div>
