<% content_for :title, "Reset Password" %>

<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4 text-2xl"
       style="background:#FFF0EB">
    🔓
  </div>
  <h1 class="text-2xl font-extrabold text-gray-900">Set a new password</h1>
  <p class="text-sm text-gray-500 mt-1">Make it something you'll remember</p>
</div>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= f.hidden_field :reset_password_token %>

  <div class="mb-4">
    <%= f.label :password, "New password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <% if @minimum_password_length %>
      <p class="text-xs text-gray-400 mb-1.5">Minimum <%= @minimum_password_length %> characters</p>
    <% end %>
    <%= f.password_field :password,
          autofocus: true,
          autocomplete: "new-password",
          placeholder: "Enter new password",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <div class="mb-6">
    <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          placeholder: "Repeat new password",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%= f.submit "Reset My Password",
        class: "w-full py-3 rounded-xl font-bold text-white text-base cursor-pointer transition-transform hover:scale-[1.02]",
        style: "background:#FF4500" %>

<% end %>

<div class="text-center mt-6">
  <%= link_to "← Back to Sign In", new_user_session_path,
        class: "text-sm font-medium hover:underline", style: "color:#FF4500" %>
</div>
