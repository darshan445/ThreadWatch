<% content_for :title, "Sign In" %>

<%# ── Header ── %>
<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4 text-2xl"
       style="background:#FFF0EB">
    🔑
  </div>
  <h1 class="text-2xl font-extrabold text-gray-900">Welcome back</h1>
  <p class="text-sm text-gray-500 mt-1">Sign in to your ThreadWatch account</p>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%# Email %>
  <div class="mb-4">
    <%= f.label :email, "Email address", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: "you@example.com",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:border-transparent transition",
          style: "focus-ring-color:#FF4500",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# Password %>
  <div class="mb-2">
    <%= f.label :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.password_field :password,
          autocomplete: "current-password",
          placeholder: "••••••••",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# Remember me + forgot password %>
  <div class="flex items-center justify-between mb-6 mt-3">
    <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
      <%= f.check_box :remember_me, class: "rounded border-gray-300 text-orange-500 cursor-pointer" %>
      Remember me
    </label>
    <%= link_to "Forgot password?", new_password_path(resource_name),
          class: "text-sm font-semibold hover:underline", style: "color:#FF4500" %>
  </div>

  <%# Submit ── %>
  <%= f.submit "Sign In",
        class: "w-full py-3 rounded-xl font-bold text-white text-base cursor-pointer transition-transform hover:scale-[1.02] active:scale-100",
        style: "background:#FF4500" %>

<% end %>

<%# Divider ── %>
<div class="flex items-center gap-3 my-6">
  <div class="flex-1 h-px bg-gray-200"></div>
  <span class="text-xs text-gray-400 font-medium">New to ThreadWatch?</span>
  <div class="flex-1 h-px bg-gray-200"></div>
</div>

<%# Sign up link ── %>
<%= link_to new_user_registration_path,
      class: "block w-full py-3 rounded-xl font-bold text-base text-center border-2 border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors" do %>
  Create a free account
<% end %>
