<% content_for :title, "Create Account" %>

<%# ── Header ── %>
<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4 text-2xl"
       style="background:#FFF0EB">
    🚀
  </div>
  <h1 class="text-2xl font-extrabold text-gray-900">Start your free trial</h1>
  <p class="text-sm text-gray-500 mt-1">7 days free · No credit card required</p>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%# Name %>
  <div class="mb-4">
    <%= f.label :name, "Your name", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.text_field :name,
          autofocus: true,
          autocomplete: "name",
          placeholder: "Jane Smith",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# Email %>
  <div class="mb-4">
    <%= f.label :email, "Work email", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.email_field :email,
          autocomplete: "email",
          placeholder: "you@example.com",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# Password %>
  <div class="mb-4">
    <%= f.label :password, "Password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.password_field :password,
          autocomplete: "new-password",
          placeholder: "At least 6 characters",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# Password confirmation %>
  <div class="mb-6">
    <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          placeholder: "Repeat your password",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# Submit %>
  <%= f.submit "Create Free Account",
        class: "w-full py-3 rounded-xl font-bold text-white text-base cursor-pointer transition-transform hover:scale-[1.02] active:scale-100",
        style: "background:#FF4500" %>

<% end %>

<%# Trust line %>
<p class="text-center text-xs text-gray-400 mt-4">
  No credit card required · Cancel anytime
</p>

<%# Divider %>
<div class="flex items-center gap-3 my-6">
  <div class="flex-1 h-px bg-gray-200"></div>
  <span class="text-xs text-gray-400 font-medium">Already have an account?</span>
  <div class="flex-1 h-px bg-gray-200"></div>
</div>

<%= link_to new_user_session_path,
      class: "block w-full py-3 rounded-xl font-bold text-base text-center border-2 border-gray-200 text-gray-700 hover:bg-gray-50 transition-colors" do %>
  Sign in instead
<% end %>
