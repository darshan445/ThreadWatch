<% content_for :title, "Account Settings" %>

<div class="text-center mb-8">
  <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl mb-4 text-2xl"
       style="background:#FFF0EB">
    ⚙️
  </div>
  <h1 class="text-2xl font-extrabold text-gray-900">Account Settings</h1>
  <p class="text-sm text-gray-500 mt-1">Update your profile and password</p>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%# ── Profile section ── %>
  <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">Profile</p>

  <div class="mb-4">
    <%= f.label :name, "Your name", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.text_field :name,
          autocomplete: "name",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <div class="mb-6">
    <%= f.label :email, "Email address", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.email_field :email,
          autocomplete: "email",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# ── Password section ── %>
  <div class="border-t border-gray-100 pt-6 mt-2 mb-4">
    <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">Change Password</p>
    <p class="text-xs text-gray-400 mb-4">Leave blank to keep your current password</p>
  </div>

  <div class="mb-4">
    <%= f.label :password, "New password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.password_field :password,
          autocomplete: "new-password",
          placeholder: "Leave blank to keep current",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <div class="mb-6">
    <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          placeholder: "Leave blank to keep current",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%# ── Current password (required by Devise) ── %>
  <div class="bg-gray-50 rounded-xl p-4 mb-6 border border-gray-200">
    <%= f.label :current_password, "Current password", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
    <p class="text-xs text-gray-400 mb-2">Required to confirm any changes above</p>
    <%= f.password_field :current_password,
          autocomplete: "current-password",
          placeholder: "Your current password",
          class: "w-full px-4 py-3 rounded-xl border border-gray-300 text-sm bg-white focus:outline-none transition",
          onfocus: "this.style.borderColor='#FF4500'; this.style.boxShadow='0 0 0 3px rgba(255,69,0,0.15)'",
          onblur:  "this.style.borderColor='#D1D5DB'; this.style.boxShadow='none'" %>
  </div>

  <%= f.submit "Save Changes",
        class: "w-full py-3 rounded-xl font-bold text-white text-base cursor-pointer transition-transform hover:scale-[1.02]",
        style: "background:#FF4500" %>

<% end %>

<%# ── Danger zone ── %>
<div class="border-t border-gray-100 mt-8 pt-6">
  <p class="text-xs font-bold uppercase tracking-widest text-red-400 mb-3">Danger Zone</p>
  <p class="text-xs text-gray-400 mb-4">
    Deleting your account is permanent and cannot be undone.
  </p>
  <%= button_to "Delete My Account", registration_path(resource_name),
        data: { turbo_method: :delete, turbo_confirm: "Are you sure? This cannot be undone." },
        class: "w-full py-3 rounded-xl font-bold text-sm text-red-600 border-2 border-red-200 hover:bg-red-50 transition-colors cursor-pointer" %>
</div>
