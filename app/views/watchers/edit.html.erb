<% content_for :title, "Edit Watcher" %>

<div class="max-w-2xl">
  <%= link_to "← My Watchers", watchers_path, class: "text-sm text-gray-400 hover:text-gray-600 mb-4 inline-block" %>
  <h1 class="text-2xl font-bold text-gray-900 mb-1">Edit Watcher</h1>
  <p class="text-gray-500 text-sm mb-6">Review and adjust the AI-generated keywords and subreddits for "<%= @watcher.name %>".</p>

  <%= render "form", watcher: @watcher %>
</div>
