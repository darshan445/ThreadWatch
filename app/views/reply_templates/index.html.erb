<% content_for :title, "Reply Templates" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Reply Templates</h1>
  <p class="text-gray-500 text-sm mt-0.5">Save replies and copy them to Reddit in one click.</p>
</div>

<div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 mb-8">
  <h2 class="text-sm font-semibold text-gray-900 mb-3">New template</h2>
  <%= form_with model: @reply_template, class: "space-y-4" do |f| %>
    <% if @reply_template.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-200 p-3 text-sm text-red-700">
        <%= @reply_template.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :name, "Name", class: "block text-xs font-semibold text-gray-500 mb-1" %>
        <%= f.text_field :name, placeholder: "Friendly intro",
              class: "w-full px-3 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-orange-500 focus:border-orange-500" %>
      </div>
    </div>
    <div>
      <%= f.label :body, "Reply body", class: "block text-xs font-semibold text-gray-500 mb-1" %>
      <%= f.text_area :body, rows: 4,
            placeholder: "Hey! I built something for exactly this…",
            class: "w-full px-3 py-2 rounded-xl border border-gray-300 text-sm focus:outline-none focus:ring-1 focus:ring-orange-500 focus:border-orange-500 resize-y" %>
    </div>
    <%= f.submit "Add template",
          class: "px-5 py-2 rounded-xl text-sm font-semibold text-white cursor-pointer",
          style: "background:#FF4500" %>
  <% end %>
</div>

<% if @reply_templates.any? %>
  <div class="space-y-3">
    <% @reply_templates.each do |t| %>
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2">
              <h2 class="font-semibold text-gray-900"><%= t.name %></h2>
              <% if t.use_count > 0 %>
                <span class="text-xs text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
                  Used <%= t.use_count %> <%= "time".pluralize(t.use_count) %>
                </span>
              <% end %>
            </div>
            <p class="text-sm text-gray-600 leading-relaxed line-clamp-4"><%= t.body %></p>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <button type="button"
                    onclick="navigator.clipboard.writeText(<%= t.body.to_json %>)"
                    class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-gray-200 text-gray-600 hover:bg-gray-50">
              Copy
            </button>
            <%= button_to reply_template_path(t), method: :delete,
                  data: { turbo_confirm: "Delete \"#{t.name}\"?" },
                  class: "px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-100 text-red-500 hover:bg-red-50" do %>
              Delete
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm py-16 text-center text-gray-500 text-sm">
    No templates yet. Add one above.
  </div>
<% end %>
