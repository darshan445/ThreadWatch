<% if score >= 150
     cls   = "bg-green-100 text-green-800"
     label = "Hot"
   elsif score >= 80
     cls   = "bg-yellow-100 text-yellow-800"
     label = "Warm"
   else
     cls   = "bg-gray-100 text-gray-600"
     label = "Cool"
   end %>
<span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full flex-shrink-0 <%= cls %>">
  <span><%= score %></span>
  <span class="font-semibold opacity-90"><%= label %></span>
</span>
