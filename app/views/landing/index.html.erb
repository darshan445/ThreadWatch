<%# ─── NAVBAR ─────────────────────────────────────────────────────────── %>
<header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">

    <a href="/" class="text-2xl font-extrabold" style="color:#FF4500">
      RedditLeads
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
      <a href="#how-it-works" class="hover:text-gray-900">How It Works</a>
      <a href="#features"     class="hover:text-gray-900">Features</a>
      <a href="#pricing"      class="hover:text-gray-900">Pricing</a>
    </nav>

    <div class="flex items-center gap-3">
      <% if user_signed_in? %>
        <%= link_to "Dashboard →", dashboard_path,
              class: "px-4 py-2 rounded-lg font-semibold text-sm text-white",
              style: "background:#FF4500" %>
      <% else %>
        <%= link_to "Login", new_user_session_path,
              class: "px-4 py-2 rounded-lg font-semibold text-sm text-gray-700 border border-gray-300 hover:bg-gray-50" %>
        <%= link_to "Start Free Trial", new_user_registration_path,
              class: "px-4 py-2 rounded-lg font-semibold text-sm text-white",
              style: "background:#FF4500" %>
      <% end %>
    </div>
  </div>
</header>


<%# ─── HERO ───────────────────────────────────────────────────────────── %>
<section class="bg-white py-24">
  <div class="max-w-4xl mx-auto px-6 text-center">

    <div class="inline-block mb-6 px-4 py-1.5 rounded-full text-sm font-semibold text-white" style="background:#FF4500">
      Reddit → Paying Customers
    </div>

    <h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 leading-tight mb-6">
      Find Customers on Reddit<br>
      <span style="color:#FF4500">Before Your Competitors Do</span>
    </h1>

    <p class="text-xl text-gray-600 max-w-2xl mx-auto mb-10">
      RedditLeads monitors Reddit 24/7 and alerts you the moment
      someone asks for a tool like yours — so you can be the first
      helpful answer in the thread.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
      <%= link_to "Start Free 7-Day Trial", new_user_registration_path,
            class: "w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-lg text-white shadow-lg",
            style: "background:#FF4500" %>
      <%= link_to "Login", new_user_session_path,
            class: "w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-lg text-gray-700 border-2 border-gray-300 hover:bg-gray-50" %>
    </div>

    <p class="text-sm text-gray-500">
      No credit card required &nbsp;·&nbsp; 7 day free trial &nbsp;·&nbsp; Cancel anytime
    </p>

  </div>
</section>


<%# ─── HOW IT WORKS ───────────────────────────────────────────────────── %>
<section id="how-it-works" class="bg-gray-50 py-20">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-14">
      <h2 class="text-4xl font-bold text-gray-900 mb-3">How It Works</h2>
      <p class="text-lg text-gray-600">Set up in 2 minutes. Get leads while you sleep.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% [
        { icon: "🎯", step: "1", title: "Tell us what you sell",
          body: "Enter your keywords and the subreddits your customers hang out in. Takes 2 minutes." },
        { icon: "👀", step: "2", title: "We watch Reddit 24/7",
          body: "RedditLeads scans Reddit every 30 minutes for threads where people are actively looking for a tool like yours." },
        { icon: "🔔", step: "3", title: "Get alerted the moment it happens",
          body: "Receive a daily digest email with the best leads ranked by score — reply while the thread is still fresh." },
        { icon: "💬", step: "4", title: "Reply and get customers",
          body: "Use your saved reply templates to respond fast. Track which threads you replied to and which converted." }
      ].each do |s| %>
        <div class="bg-white rounded-2xl p-7 border border-gray-200 flex flex-col gap-4">
          <div class="text-4xl"><%= s[:icon] %></div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color:#FF4500">Step <%= s[:step] %></div>
          <h3 class="text-lg font-bold text-gray-900"><%= s[:title] %></h3>
          <p class="text-gray-600 text-sm leading-relaxed"><%= s[:body] %></p>
        </div>
      <% end %>
    </div>

  </div>
</section>


<%# ─── PROBLEM / SOLUTION ─────────────────────────────────────────────── %>
<section class="bg-white py-20">
  <div class="max-w-5xl mx-auto px-6">

    <h2 class="text-4xl font-bold text-gray-900 text-center mb-12">
      The Reddit window closes fast
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

      <%# Without %>
      <div class="rounded-2xl border-2 border-red-200 bg-red-50 p-8">
        <h3 class="text-xl font-bold text-red-700 mb-6">❌ Without RedditLeads</h3>
        <ul class="space-y-4">
          <% [
            "Manually search Reddit every day",
            "Find a perfect post — from 3 days ago",
            "Your comment gets buried under 40 others",
            "Nobody sees it. No customers."
          ].each do |point| %>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-red-400 font-bold text-lg">✗</span>
              <span class="text-red-800 text-sm"><%= point %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <%# With %>
      <div class="rounded-2xl border-2 border-green-200 bg-green-50 p-8">
        <h3 class="text-xl font-bold text-green-700 mb-6">✅ With RedditLeads</h3>
        <ul class="space-y-4">
          <% [
            "Reddit monitored automatically 24/7",
            "Get alerted within 30 mins of a matching post",
            "You reply while thread is still hot",
            "First helpful answer. Customers notice you."
          ].each do |point| %>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 text-green-500 font-bold text-lg">✓</span>
              <span class="text-green-800 text-sm"><%= point %></span>
            </li>
          <% end %>
        </ul>
      </div>

    </div>
  </div>
</section>


<%# ─── FEATURES ───────────────────────────────────────────────────────── %>
<section id="features" class="bg-gray-50 py-20">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-14">
      <h2 class="text-4xl font-bold text-gray-900 mb-3">
        Everything you need to turn Reddit into a customer channel
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% [
        { icon: "🔍", title: "Keyword Monitoring",
          body: "Set keywords and subreddits once. We scan every 30 minutes and surface only the threads that match." },
        { icon: "📊", title: "Lead Scoring",
          body: "Every lead is scored by recency, upvotes and engagement. Highest quality leads always appear first." },
        { icon: "📧", title: "Daily Digest Email",
          body: "Get a clean email every morning with your top leads ranked and ready to action." },
        { icon: "💬", title: "Reply Templates",
          body: "Save your best responses. One click to copy and paste into Reddit. Never write the same reply twice." },
        { icon: "✅", title: "Engagement Tracking",
          body: "Mark leads as Replied, Converted or Ignored. Never accidentally reply to the same thread twice." },
        { icon: "⚡", title: "30-Minute Checks",
          body: "Reddit threads have a 2–4 hour golden window. We make sure you never miss it." }
      ].each do |f| %>
        <div class="bg-white rounded-2xl p-7 border border-gray-200">
          <div class="text-3xl mb-4"><%= f[:icon] %></div>
          <h3 class="text-lg font-bold text-gray-900 mb-2"><%= f[:title] %></h3>
          <p class="text-gray-600 text-sm leading-relaxed"><%= f[:body] %></p>
        </div>
      <% end %>
    </div>

  </div>
</section>


<%# ─── PRICING ────────────────────────────────────────────────────────── %>
<section id="pricing" class="bg-white py-20">
  <div class="max-w-lg mx-auto px-6 text-center">

    <h2 class="text-4xl font-bold text-gray-900 mb-3">Simple Pricing</h2>
    <p class="text-lg text-gray-600 mb-12">One plan. Everything included.</p>

    <div class="rounded-2xl border-2 p-10 shadow-xl" style="border-color:#FF4500">

      <div class="inline-block mb-4 px-4 py-1 rounded-full text-sm font-bold text-white" style="background:#FF4500">
        Founder Plan
      </div>

      <div class="mt-4 mb-2">
        <span class="text-6xl font-extrabold text-gray-900">$29</span>
        <span class="text-xl text-gray-500">/month</span>
      </div>
      <p class="text-sm text-gray-500 mb-8">or $290/year <span class="font-semibold text-green-600">(save 2 months)</span></p>

      <ul class="text-left space-y-3 mb-10">
        <% [
          "Unlimited keyword watchers",
          "All subreddits supported",
          "Checks every 30 minutes",
          "Daily digest emails",
          "Reply template manager",
          "Lead scoring and tracking",
          "7-day free trial"
        ].each do |feature| %>
          <li class="flex items-center gap-3 text-gray-700">
            <span class="font-bold text-green-500">✓</span>
            <%= feature %>
          </li>
        <% end %>
      </ul>

      <%= link_to "Start Free Trial", new_user_registration_path,
            class: "block w-full py-4 rounded-xl font-bold text-lg text-white",
            style: "background:#FF4500" %>

      <p class="mt-4 text-sm text-gray-400">No credit card required to start</p>

    </div>
  </div>
</section>


<%# ─── FAQ ────────────────────────────────────────────────────────────── %>
<section class="bg-gray-50 py-20">
  <div class="max-w-3xl mx-auto px-6">

    <h2 class="text-4xl font-bold text-gray-900 text-center mb-12">
      Frequently Asked Questions
    </h2>

    <div class="space-y-6">
      <% [
        {
          q: "Do I need Reddit credentials or API access?",
          a: "No. RedditLeads uses Reddit's public data. No Reddit account or API key needed on your end."
        },
        {
          q: "How is this different from F5bot?",
          a: "F5bot gives you basic keyword alerts with no filtering, no scoring, no templates and no engagement tracking. RedditLeads is built specifically for founders who want to acquire customers, not just get notifications."
        },
        {
          q: "What subreddits can I monitor?",
          a: "Any public subreddit. Most founders monitor communities like r/entrepreneur, r/freelance, r/SaaS, r/webdev and niche subreddits specific to their industry."
        },
        {
          q: "Will I get spammy or irrelevant leads?",
          a: "Lead scoring filters out low-quality matches. You see the highest scoring leads first — recent posts with high engagement that closely match your keywords."
        },
        {
          q: "Can I cancel anytime?",
          a: "Yes. No contracts, no commitments. Cancel from your account settings anytime."
        }
      ].each do |faq| %>
        <div class="bg-white rounded-2xl border border-gray-200 p-7">
          <h3 class="font-bold text-gray-900 mb-2"><%= faq[:q] %></h3>
          <p class="text-gray-600 text-sm leading-relaxed"><%= faq[:a] %></p>
        </div>
      <% end %>
    </div>

  </div>
</section>


<%# ─── FINAL CTA ──────────────────────────────────────────────────────── %>
<section class="py-24" style="background:#FF4500">
  <div class="max-w-3xl mx-auto px-6 text-center">

    <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-4">
      Start finding customers on Reddit today
    </h2>
    <p class="text-xl text-orange-100 mb-10">
      Join founders who stopped searching manually and started
      letting RedditLeads do it for them.
    </p>

    <%= link_to "Start Free 7-Day Trial", new_user_registration_path,
          class: "inline-block px-10 py-5 rounded-xl bg-white font-bold text-lg",
          style: "color:#FF4500" %>

    <p class="mt-5 text-orange-200 text-sm">No credit card required</p>

  </div>
</section>


<%# ─── FOOTER ─────────────────────────────────────────────────────────── %>
<footer class="bg-white border-t border-gray-100 py-8">
  <div class="max-w-6xl mx-auto px-6 text-center text-sm text-gray-400">
    © <%= Date.current.year %> RedditLeads · Built for solo founders
  </div>
</footer>
